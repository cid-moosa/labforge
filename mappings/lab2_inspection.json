    "total_non_empty_paragraphs": 21,
    "paragraphs": [
      {
        "paragraph_index": 0,
        "style": "Heading 1",
        "category": "body",
        "text": "PRACTICAL-2",
        "char_count": 11
      },
      {
        "paragraph_index": 3,
        "style": "Body Text",
        "category": "heading",
        "text": "AIM: To perform forensics analysis of image files and create report.",
        "char_count": 68
      },
      {
        "paragraph_index": 4,
        "style": "Normal",
        "category": "body",
        "text": "TOOL USED: Autopsy",
        "char_count": 18
      },
      {
        "paragraph_index": 5,
        "style": "Body Text",
        "category": "body",
        "text": "Autopsy is an open-source digital forensics tool developed by Basis Technology, first released in 2000. It is an efficient tool for hard drive investigation and forensic image analysis with features like multiuser cases, timeline analysis, registry analysis, keyword search, email analysis, media playback, EXIF analysis, malicious file detection and much more.",
        "char_count": 361
      },
      {
        "paragraph_index": 7,
        "style": "Normal",
        "category": "body",
        "text": "How to use Autopsy for digital investigation?",
        "char_count": 45
      },
      {
        "paragraph_index": 8,
        "style": "List Paragraph",
        "category": "body",
        "text": "Run Autopsy and select New Case.",
        "char_count": 32
      },
      {
        "paragraph_index": 10,
        "style": "List Paragraph",
        "category": "body",
        "text": "Provide the Case Name and the directory to store the case file. Click on Next.",
        "char_count": 78
      },
      {
        "paragraph_index": 12,
        "style": "List Paragraph",
        "category": "body",
        "text": "Select a host name. You can specify your own name or you can opt to generate new host name based on data source name. Click Next.",
        "char_count": 129
      },
      {
        "paragraph_index": 14,
        "style": "List Paragraph",
        "category": "body",
        "text": "Choose the required data source type, in this case Disk Image and click on Next.",
        "char_count": 80
      },
      {
        "paragraph_index": 16,
        "style": "List Paragraph",
        "category": "body",
        "text": "Give path of the data source (the forensic image file to be examined) and click on Next.",
        "char_count": 88
      },
      {
        "paragraph_index": 18,
        "style": "List Paragraph",
        "category": "body",
        "text": "Wait for the data source to be processed and added to the local database.",
        "char_count": 73
      },
      {
        "paragraph_index": 20,
        "style": "List Paragraph",
        "category": "body",
        "text": "After the data source is added to the local database, click Finish.",
        "char_count": 67
      },
      {
        "paragraph_index": 22,
        "style": "List Paragraph",
        "category": "body",
        "text": "Select the required ingest modules and click on Next.",
        "char_count": 53
      },
      {
        "paragraph_index": 24,
        "style": "List Paragraph",
        "category": "body",
        "text": "You reach here once all the modules have been ingested. You can begin investigating but it is recommended to wait until analysis and integrity check is complete.",
        "char_count": 161
      },
      {
        "paragraph_index": 26,
        "style": "Normal",
        "category": "body",
        "text": "Generating Report",
        "char_count": 17
      },
      {
        "paragraph_index": 28,
        "style": "Normal",
        "category": "body",
        "text": "To generate a report, click on the Generate Report tab and then select the format in which you want the report and click Next.",
        "char_count": 126
      },
      {
        "paragraph_index": 29,
        "style": "List Paragraph",
        "category": "body",
        "text": "Select the data source to include and click Next.",
        "char_count": 49
      },
      {
        "paragraph_index": 30,
        "style": "List Paragraph",
        "category": "body",
        "text": "Select the items to include in the file report and click Finish.",
        "char_count": 64
      },
      {
        "paragraph_index": 31,
        "style": "List Paragraph",
        "category": "body",
        "text": "When the report generation is complete, click on the link to view the report. You can also open the report from the location where it is saved. Click Close",
        "char_count": 155
      },
      {
        "paragraph_index": 32,
        "style": "List Paragraph",
        "category": "output_heading",
        "text": "OUTPUT",
        "char_count": 6
      },
      {
        "paragraph_index": 33,
        "style": "Body Text",
        "category": "body",
        "text": "Successfully performed forensics analysis of image files and created report.",
        "char_count": 76
      }
    ]
  },
